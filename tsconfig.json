{
  "compilerOptions": {
    "target": "ES2020",
    // ES2020 syntax output; ES2021 APIs such as replaceAll need native support or a polyfill.
    // Library declarations do not add runtime polyfills.
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "scripts"]
}
